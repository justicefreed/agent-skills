#!/usr/bin/env python3
"""Paseo Claude worker lane profile: strip the plugins that inflate a lane.

Configured as the Paseo `claude` provider's command, so the Claude Agent SDK
launches this script with the normal Claude Code argv and cwd set to the
agent's worktree. It locates the real `claude` binary and, when the worktree
is inside a lane root, injects `lane-settings.json` as a `--settings`
argument. A missing or invalid settings file never blocks a launch.

Env:
  CLAUDE_LANE_REAL_BINARY  the real claude binary (default: first `claude` on
                           PATH whose realpath is not this script's)
  CLAUDE_LANE_ROOTS        os.pathsep-separated lane roots (default:
                           ~/.paseo/worktrees)
  CLAUDE_LANE_SETTINGS     the lane settings JSON (default: lane-settings.json
                           next to this script)
  CLAUDE_LANE_PROFILE=0    disable injection entirely
"""
import json
import os
import sys
from typing import Any, Dict, List, Optional


def real_binary() -> Optional[str]:
    override = os.environ.get("CLAUDE_LANE_REAL_BINARY")
    if override:
        return override
    here = os.path.realpath(__file__)
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        if not directory:
            continue
        candidate = os.path.join(directory, "claude")
        if not os.path.isfile(candidate) or not os.access(candidate, os.X_OK):
            continue
        if os.path.realpath(candidate) == here:
            continue
        return candidate
    return None


def lane_roots() -> List[str]:
    raw = os.environ.get("CLAUDE_LANE_ROOTS",
                         os.path.join("~", ".paseo", "worktrees"))
    return [os.path.expanduser(p) for p in raw.split(os.pathsep) if p.strip()]


def inside_lane_root(cwd: str) -> bool:
    real = os.path.realpath(cwd)
    for root in lane_roots():
        root_real = os.path.realpath(root)
        if real.startswith(root_real + os.sep):
            return True
    return False


def load_settings() -> Optional[str]:
    """The lane settings JSON, or None when missing or invalid."""
    raw = os.environ.get("CLAUDE_LANE_SETTINGS")
    if raw:
        try:
            json.loads(raw)
        except ValueError:
            return None
        return raw
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                        "lane-settings.json")
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None
    return json.dumps(data)


def deep_merge(caller: Any, lane: Any) -> Any:
    """Deep-merge lane settings into the caller's; the caller wins on
    conflicts except for the lane profile's enabledPlugins entries, which win.
    """
    if isinstance(caller, dict) and isinstance(lane, dict):
        out = dict(caller)
        for key, value in lane.items():
            if key == "enabledPlugins" and isinstance(value, dict):
                merged = dict(out.get(key)) if isinstance(out.get(key), dict) else {}
                for plugin, enabled in value.items():
                    merged[plugin] = enabled
                out[key] = merged
            elif key in out:
                out[key] = deep_merge(out[key], value)
            else:
                out[key] = value
        return out
    return caller


def merge_with_existing(existing: str, lane_json: str) -> Optional[str]:
    """Merge the lane settings into an existing --settings value.

    The value may be a JSON string or a file path. None when it cannot be
    parsed, so the caller can launch unmodified rather than guess.
    """
    try:
        if existing.lstrip().startswith("{"):
            caller = json.loads(existing)
        else:
            with open(os.path.expanduser(existing), "r", encoding="utf-8") as fh:
                caller = json.load(fh)
    except (OSError, ValueError):
        return None
    if not isinstance(caller, dict):
        return None
    merged = deep_merge(caller, json.loads(lane_json))
    return json.dumps(merged)


def inject_settings(argv: List[str], lane_json: str) -> Optional[List[str]]:
    """argv with the lane settings injected, or None when the caller's
    existing --settings cannot be merged."""
    for i, arg in enumerate(argv):
        if arg == "--settings":
            if i + 1 >= len(argv):
                return None
            merged = merge_with_existing(argv[i + 1], lane_json)
            if merged is None:
                return None
            return argv[:i] + ["--settings", merged] + argv[i + 2:]
        if arg.startswith("--settings="):
            merged = merge_with_existing(arg[len("--settings="):], lane_json)
            if merged is None:
                return None
            return argv[:i] + ["--settings", merged] + argv[i + 1:]
    return argv + ["--settings", lane_json]


def main(argv: Optional[List[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    binary = real_binary()
    if binary is None:
        print("claude-lane: no real claude binary found on PATH "
              "(set CLAUDE_LANE_REAL_BINARY)", file=sys.stderr)
        return 127
    if os.environ.get("CLAUDE_LANE_PROFILE") == "0":
        os.execv(binary, [binary] + argv)
    if not inside_lane_root(os.getcwd()):
        os.execv(binary, [binary] + argv)
    if len(argv) == 1 and argv[0] in ("--version", "-v", "--help", "-h"):
        os.execv(binary, [binary] + argv)
    lane_json = load_settings()
    if lane_json is None:
        print("claude-lane: lane settings missing or invalid; launching "
              "unmodified", file=sys.stderr)
        os.execv(binary, [binary] + argv)
    merged = inject_settings(argv, lane_json)
    if merged is None:
        print("claude-lane: existing --settings unparseable; launching "
              "unmodified", file=sys.stderr)
        os.execv(binary, [binary] + argv)
    os.execv(binary, [binary] + merged)


if __name__ == "__main__":
    sys.exit(main())
