#!/usr/bin/python3
"""A hermetic stand-in for agent-track's `show` and `advance`.

State is the JSON fixture named by FAKE_TRACK_FIXTURE:
  {"items": {"T-015": {"title": "...", "tasks": [{"label": "...", "checked": false,
                                                  "actor": "optional gate"}],
                        "blockedBy": []}}}
Every advance attempt (success or not) is appended to FAKE_TRACK_LOG as one
line. Errors follow agent-track's contract: exit 1, and under --json one JSON
object with `error` (and `message`) on stderr.
"""
import json
import os
import sys

argv = sys.argv[1:]
as_json = "--json" in argv
fixture = os.environ["FAKE_TRACK_FIXTURE"]
log = os.environ.get("FAKE_TRACK_LOG")


def fail(code, message):
    if as_json:
        sys.stderr.write(json.dumps({"error": code, "message": message}) + "\n")
    else:
        sys.stderr.write("%s: %s\n" % (code, message))
    sys.exit(1)


def flag(name):
    return argv[argv.index(name) + 1] if name in argv else None


def positional():
    skip, out = False, []
    for a in argv[1:]:
        if skip:
            skip = False
        elif a in ("--cwd", "--expect"):
            skip = True
        elif not a.startswith("--"):
            out.append(a)
    return out


def current(item):
    for task in item["tasks"]:
        if not task.get("checked"):
            return task
    return None


def shape(item_id, item):
    cur = current(item)
    return {"id": item_id, "title": item.get("title", item_id),
            "done": cur is None, "tasks": item["tasks"],
            "progress": {"done": sum(1 for t in item["tasks"] if t.get("checked")),
                         "total": len(item["tasks"])},
            "currentTask": ({"label": cur["label"], "actor": cur.get("actor")}
                            if cur else None),
            "blockedBy": item.get("blockedBy", []), "blocks": []}


if not argv or argv[0] not in ("show", "advance"):
    fail("USAGE", "fake-track supports show and advance only")
ids = positional()
if not ids:
    fail("USAGE", "an item id is required")
with open(fixture, "r", encoding="utf-8") as fh:
    data = json.load(fh)
item = data["items"].get(ids[0])
if argv[0] == "advance" and log:
    with open(log, "a", encoding="utf-8") as fh:
        fh.write("advance %s expect=%s notify=%s\n"
                 % (ids[0], flag("--expect"), "--notify" in argv))
if item is None:
    fail("ITEM_NOT_FOUND", "no item %s" % ids[0])
if argv[0] == "show":
    print(json.dumps(shape(ids[0], item)) if as_json else item.get("title", ""))
    sys.exit(0)
cur = current(item)
if cur is None:
    fail("ITEM_COMPLETE", "every task of %s is ticked" % ids[0])
if cur.get("actor"):
    fail("GATE_REQUIRES_RULING", "current task carries !%s" % cur["actor"])
forced = os.environ.get("FAKE_TRACK_ADVANCE_ERROR")
if forced:  # simulate a write that lost a race after `show` said it was current
    fail(forced, "forced by FAKE_TRACK_ADVANCE_ERROR")
expect = flag("--expect")
if expect is not None and expect != cur["label"]:
    fail("WRITE_CONFLICT", "current task is %r, not %r" % (cur["label"], expect))
cur["checked"] = True
tmp = fixture + ".tmp"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2)
os.replace(tmp, fixture)
print(json.dumps({"action": "advance", "item": shape(ids[0], item)}))
